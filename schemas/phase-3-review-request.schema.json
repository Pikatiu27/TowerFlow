{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://towerflow.local/schemas/phase-3-review-request.schema.json",
  "title": "TowerFlow Phase 3 mapped-action review request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "mode",
    "modelId",
    "actionScenarioId",
    "projectInput"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.5.0-review"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "mode": {
      "const": "mapped_action_review"
    },
    "modelId": {
      "const": "fec-type-aa-full-elevation-demo"
    },
    "actionScenarioId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "projectInput": {
      "$ref": "https://pikatiu27.github.io/TowerFlow/schemas/phase-3-project-input.schema.json"
    }
  }
}
