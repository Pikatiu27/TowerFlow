{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pikatiu27.github.io/TowerFlow/schemas/phase-3-cross-surface-acceptance.schema.json",
  "title": "TowerFlow Phase 3A Cross-Surface Acceptance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hashBasis",
    "status",
    "requestFile",
    "resultFile",
    "snapshotFile",
    "ruleReviewFile",
    "requestSha256",
    "resultSha256",
    "snapshotSha256",
    "checks",
    "releaseAuthority",
    "issues",
    "reportSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-cross-surface-acceptance" },
    "hashBasis": { "const": "canonical-json-sort-keys-compact" },
    "status": { "enum": ["BLOCKED", "READY_FOR_PROJECT_RELEASE_REVIEW"] },
    "requestFile": { "type": "string", "minLength": 1 },
    "resultFile": { "type": "string", "minLength": 1 },
    "snapshotFile": { "type": "string", "minLength": 1 },
    "ruleReviewFile": { "type": ["string", "null"] },
    "requestSha256": { "$ref": "#/$defs/sha256" },
    "resultSha256": { "$ref": "#/$defs/sha256" },
    "snapshotSha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": { "type": "string", "pattern": "^P3A-AC-[0-9]{2}$" },
          "status": { "enum": ["PASS", "BLOCKED"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "releaseAuthority": { "const": false },
    "issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reportSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
