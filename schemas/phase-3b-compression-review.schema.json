{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pikatiu27.github.io/TowerFlow/schemas/phase-3b-compression-review.schema.json",
  "title": "TowerFlow Phase 3B CHS Compression Review Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffId",
    "status",
    "prepared",
    "scope",
    "controlledSource",
    "artifacts",
    "benchmarkRequirement",
    "reviewItems",
    "reviewer",
    "completion",
    "restrictions"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-review-control" },
    "handoffId": { "const": "P3B-COMP-REVIEW-001" },
    "status": {
      "enum": ["blank_engineering_review", "review_in_progress", "engineering_review_complete"]
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparedBy", "preparedDate", "purpose"],
      "properties": {
        "preparedBy": { "const": "TowerFlow Phase 3B implementation" },
        "preparedDate": { "type": "string", "format": "date" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleSetId",
        "calculationStatus",
        "forceState",
        "actionMode",
        "sectionFamily",
        "manufacturingRoute",
        "releaseGateIds"
      ],
      "properties": {
        "ruleSetId": { "const": "as-4100-2020-amd1-section-6-compression-chs-v0.1" },
        "calculationStatus": { "const": "verification_only" },
        "forceState": { "const": "compression" },
        "actionMode": { "const": "concentric_axial_only" },
        "sectionFamily": { "const": "circular_hollow_section" },
        "manufacturingRoute": { "const": "cold_formed_non_stress_relieved" },
        "releaseGateIds": { "const": ["CM3-07", "CM3-08"] }
      }
    },
    "controlledSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication",
        "incorporatedAmendments",
        "sourceFingerprintStatus",
        "licensedSourceBundled",
        "reviewerMustUseControlledCopy"
      ],
      "properties": {
        "publication": { "const": "AS 4100:2020" },
        "incorporatedAmendments": { "const": ["Amendment No. 1 (September 2021)"] },
        "sourceFingerprintStatus": { "const": "held_outside_public_repository" },
        "licensedSourceBundled": { "const": false },
        "reviewerMustUseControlledCopy": { "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "benchmarkRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allowedMethods",
        "requiredCaseIds",
        "capacityComparisonTolerance",
        "requiredEvidence",
        "exchangePackage",
        "evidence"
      ],
      "properties": {
        "status": { "enum": ["pending", "evidence_supplied", "accepted", "rejected"] },
        "allowedMethods": { "const": ["independent_hand_calculation", "trusted_software"] },
        "requiredCaseIds": {
          "const": [
            "COMPRESSION-CHS-B01",
            "COMPRESSION-CHS-B02",
            "COMPRESSION-CHS-B03",
            "COMPRESSION-CHS-B04"
          ]
        },
        "capacityComparisonTolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "absoluteKN", "relative"],
          "properties": {
            "rule": { "const": "difference_lte_max_absolute_or_relative_allowance" },
            "absoluteKN": { "const": 0.5 },
            "relative": { "const": 0.005 }
          }
        },
        "requiredEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputIdentityConfirmed",
            "intermediateResultsRecorded",
            "finalCapacityRecorded",
            "methodIdentityRecorded",
            "signedRecordRequired"
          ],
          "properties": {
            "inputIdentityConfirmed": { "const": true },
            "intermediateResultsRecorded": { "const": true },
            "finalCapacityRecorded": { "const": true },
            "methodIdentityRecorded": { "const": true },
            "signedRecordRequired": { "const": true }
          }
        },
        "exchangePackage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exchangeId", "path", "requestPayloadSha256"],
          "properties": {
            "exchangeId": { "const": "P3B-COMP-BENCH-EXCHANGE-001" },
            "path": { "const": "review/phase3b-compression-benchmark-exchange.blank.json" },
            "requestPayloadSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "evidence": { "$ref": "#/$defs/benchmarkEvidence" }
      }
    },
    "reviewItems": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/reviewItem" }
    },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredReviewItemIds",
        "allItemsAccepted",
        "cm3GateStatus",
        "independentEngineeringReview",
        "releaseAuthority"
      ],
      "properties": {
        "requiredReviewItemIds": {
          "const": ["P3B-CR-01", "P3B-CR-02", "P3B-CR-03", "P3B-CR-04", "P3B-CR-05", "P3B-CR-06"]
        },
        "allItemsAccepted": { "type": "boolean" },
        "cm3GateStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CM3-07", "CM3-08"],
          "properties": {
            "CM3-07": { "enum": ["pending", "accepted", "rejected"] },
            "CM3-08": { "enum": ["pending", "accepted", "rejected"] }
          }
        },
        "independentEngineeringReview": { "enum": ["pending", "accepted", "rejected"] },
        "releaseAuthority": { "const": false }
      }
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableText": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "nullableSha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "hashBasis", "sha256", "role"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^P3B-CR-A0[1-8]$" },
        "path": {
          "type": "string",
          "pattern": "^(analysis|docs|rules|verification)/[A-Za-z0-9._/-]+$"
        },
        "hashBasis": { "const": "utf8_lf_normalized" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "role": {
          "enum": ["rule_data", "implementation", "golden_case", "verification", "independent_oracle", "governance"]
        }
      }
    },
    "comparisonResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "inputIdentityConfirmed",
        "intermediateResultsReference",
        "towerFlowCapacityKN",
        "independentCapacityKN",
        "absoluteDifferenceKN",
        "relativeDifference",
        "withinTolerance"
      ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^COMPRESSION-CHS-B0[1-4]$" },
        "inputIdentityConfirmed": { "type": "boolean" },
        "intermediateResultsReference": { "$ref": "#/$defs/nullableText" },
        "towerFlowCapacityKN": { "type": "number", "exclusiveMinimum": 0 },
        "independentCapacityKN": { "type": "number", "exclusiveMinimum": 0 },
        "absoluteDifferenceKN": { "type": "number", "minimum": 0 },
        "relativeDifference": { "type": "number", "minimum": 0 },
        "withinTolerance": { "type": "boolean" }
      }
    },
    "benchmarkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "methodDescription",
        "toolName",
        "toolVersion",
        "toolBuild",
        "preparedBy",
        "preparedByIndependentParty",
        "evidenceRecordReference",
        "benchmarkExchangeResponsePayloadSha256",
        "evidencePayloadSha256",
        "comparisonResults"
      ],
      "properties": {
        "method": {
          "anyOf": [
            { "enum": ["independent_hand_calculation", "trusted_software"] },
            { "type": "null" }
          ]
        },
        "methodDescription": { "$ref": "#/$defs/nullableText" },
        "toolName": { "$ref": "#/$defs/nullableText" },
        "toolVersion": { "$ref": "#/$defs/nullableText" },
        "toolBuild": { "$ref": "#/$defs/nullableText" },
        "preparedBy": { "$ref": "#/$defs/nullableText" },
        "preparedByIndependentParty": { "type": "boolean" },
        "evidenceRecordReference": { "$ref": "#/$defs/nullableText" },
        "benchmarkExchangeResponsePayloadSha256": { "$ref": "#/$defs/nullableSha256" },
        "evidencePayloadSha256": { "$ref": "#/$defs/nullableSha256" },
        "comparisonResults": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/comparisonResult" }
        }
      }
    },
    "reviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "title", "releaseGateIds", "artifactIds", "acceptanceCriteria", "decision", "comments"],
      "properties": {
        "itemId": { "type": "string", "pattern": "^P3B-CR-0[1-6]$" },
        "title": { "type": "string", "minLength": 1 },
        "releaseGateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["CM3-07", "CM3-08"] }
        },
        "artifactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^P3B-CR-A0[1-8]$" }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision": { "enum": ["pending", "accepted", "rejected"] },
        "comments": { "type": ["string", "null"] }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "name",
        "organisation",
        "qualification",
        "registrationReference",
        "independenceConfirmed",
        "independenceBasis",
        "authorisedSourceAccessConfirmed",
        "controlledSourceRecordReference",
        "reviewDate",
        "signedRecordReference"
      ],
      "properties": {
        "role": { "const": "independent_structural_engineer" },
        "name": { "$ref": "#/$defs/nullableText" },
        "organisation": { "$ref": "#/$defs/nullableText" },
        "qualification": { "$ref": "#/$defs/nullableText" },
        "registrationReference": { "$ref": "#/$defs/nullableText" },
        "independenceConfirmed": { "type": "boolean" },
        "independenceBasis": { "$ref": "#/$defs/nullableText" },
        "authorisedSourceAccessConfirmed": { "type": "boolean" },
        "controlledSourceRecordReference": { "$ref": "#/$defs/nullableText" },
        "reviewDate": {
          "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        },
        "signedRecordReference": { "$ref": "#/$defs/nullableText" }
      }
    }
  }
}
