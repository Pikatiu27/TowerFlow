    },
    {
      "ruleId": "TF-WEB-UI-003",
      "severity": "blocking",
      "requirement": "A view shall show no more than two overlay families and status shall include text."
    },
    {
      "ruleId": "TF-ANN-001",
      "severity": "blocking",
      "requirement": "Mandatory dimensions shall resolve from semantic model features with pinned text metrics, valid arrow targets, no prohibited text collision and placement inside the controlled view."
    },
    {
      "ruleId": "TF-REL-001",
      "severity": "blocking",
